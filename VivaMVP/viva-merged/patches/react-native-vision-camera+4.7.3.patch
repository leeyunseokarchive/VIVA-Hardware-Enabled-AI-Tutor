@@ -68,6 +68,18 @@ class CameraDevicesManager(private val reactContext: ReactApplicationContext) :
         Log.i(TAG, "Initializing ExtensionsManager...")
         extensionsManager = ExtensionsManager.getInstanceAsync(reactContext, cameraProvider!!).await(executor)
         Log.i(TAG, "Successfully initialized!")
+        // getConstants()/initialize() (which fire the FIRST "CameraDevicesChanged"
+        // event) run on RN bridge startup and can easily win the race against this
+        // coroutine, especially on a cold app start - resulting in an empty device
+        // list that nothing ever corrects afterwards (AvailabilityCallback only
+        // fires on real hardware plug/unplug, not on "we just finished init").
+        // That produces exactly the "camera not found on 1st/2nd launch, only
+        // works after force-closing and reopening" symptom, since a fresh process
+        // is the only thing that re-runs getConstants(). Fix: once this async
+        // init actually completes, re-emit the changed event ourselves so any
+        // JS-side listener (useCameraDevices/useCameraDevice) picks up the real
+        // device list within the SAME app session - no restart needed.
+        sendAvailableDevicesChangedEvent()
       } catch (error: Throwable) {
         Log.e(TAG, "Failed to initialize ProcessCameraProvider/ExtensionsManager! Error: ${error.message}", error)
       }
