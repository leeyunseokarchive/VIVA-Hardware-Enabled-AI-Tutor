# VIVA 앱 환경변수 템플릿.
# cp .env.example .env 한 뒤 값을 채운다. .env 는 커밋하지 않는다.
# EXPO_PUBLIC_ 접두사가 붙은 값은 앱 번들에 그대로 들어간다 - 서버 전용
# 비밀키는 이 접두사를 붙이지 말 것.

# --- Gemini ------------------------------------------------------------
# 발급: https://aistudio.google.com/apikey
# 필수. 비우면 gemini/geminiStt/board 서비스가 시작하자마자 예외를 던져
# 문제 인식·튜터링·판서가 전부 죽는다.
EXPO_PUBLIC_GEMINI_API_KEY=your-gemini-api-key-here
# 아래 3개는 선택. 비워도 코드의 기본값으로 동작한다 - 값을 넣으면 덮어쓴다.
# 텍스트/비전 추론 모델 ID (gemini.service.ts 기본값 사용).
EXPO_PUBLIC_GEMINI_TEXT_MODEL_ID=
# 판서 이미지 생성 모델 ID (board.service.ts 기본값 사용).
EXPO_PUBLIC_GEMINI_IMAGE_MODEL_ID=
# 판서 해상도 튜닝 노브. 느리면 1K 로 내려 A/B 한다
# (expo start -c 로 Metro 캐시를 비워야 반영된다).
EXPO_PUBLIC_GEMINI_IMAGE_SIZE=1K

# --- Supabase (필수) ---------------------------------------------------
# 발급: Supabase 프로젝트 > Settings > API
# 비우면: 세션 기록·오답노트·개념 이미지 저장이 전부 실패한다.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# 서버 전용 키. 마이그레이션·관리 스크립트에서만 쓴다. 앱 번들에 넣지 말 것.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Cloud TTS (필수) -------------------------------------------
# 발급: Google Cloud Console > API 및 서비스 > 사용자 인증 정보
# 비우면: tts.service 가 'Missing EXPO_PUBLIC_GOOGLE_TTS_API_KEY' 예외를 던진다.
# 이 예외를 잡는 곳이 없어 자막도 안 뜨고 해당 턴이 멈춘다 - 사실상 필수.
EXPO_PUBLIC_GOOGLE_TTS_API_KEY=your-google-tts-api-key-here

# --- 로봇 헤드 (VIVA for Device) ---------------------------------------
# Pi 주소. 비우면 piBridge.service.ts 의 기본 호스트를 쓴다. mDNS(viva.local)가
# 불안정한 망에서는 IP 를 직접 박는다 (2026-08-03 실기기: health 는 붙는데
# 촬영 POST 가 20초 행으로 죽었다).
EXPO_PUBLIC_PI_HOST=
# Pi Flask 서버 포트. 비우면 5000 (piBridge.service.ts 기본값).
EXPO_PUBLIC_PI_PORT=
# 로봇 눈 렌더러(pi-server/eyes.py)의 WS 주소. 예: ws://viva.local:8787
# 비우면: eyeSync 서비스 자체가 꺼진다 (앱은 정상 동작, 눈만 안 움직인다).
EXPO_PUBLIC_EYE_SYNC_WS_URL=ws://viva.local:8787

# --- 튜닝 노브 (전부 선택) ----------------------------------------------
# 호출어 감지 후 촬영까지 지연 ms. 비우면 0 (useIntentLoop.ts).
EXPO_PUBLIC_INTENT_CAPTURE_DELAY_MS=
# Gemini 이미지 해상도 힌트. 예: MEDIA_RESOLUTION_MEDIUM
# 비우면 모델 기본값. 토큰 비용과 인식 정확도의 트레이드오프 (gemini.service.ts).
EXPO_PUBLIC_GEMINI_EVAL_MEDIA_RESOLUTION=
EXPO_PUBLIC_GEMINI_RECOGNITION_MEDIA_RESOLUTION=
